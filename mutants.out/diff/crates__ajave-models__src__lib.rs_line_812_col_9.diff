 fn ret_ty(desc: &str) -> Option<Ty> {
     let after = desc.rfind(')')? + 1;
     match desc.as_bytes().get(after)? {
         b'V' => None,
         b'J' => Some(Ty::Long),
-        b'F' => Some(Ty::Float),
+         /* ~ changed by cargo-mutants ~ */
         b'D' => Some(Ty::Double),
         b'L' | b'[' => Some(Ty::Ref),
         _ => Some(Ty::Int),
     }
 }
 
