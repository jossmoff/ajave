<?xml version="1.0"?>

<!--
  BenchExec benchmark definition for ajave.

  Usage:
    benchexec benchexec/ajave.xml -t ReachSafety-Java

  Requires benchexec installed: pip install benchexec
  The tool-info module (benchexec/tools/ajave.py) must be on PYTHONPATH
  or symlinked into benchexec's tool-info directory.
-->

<benchmark tool="ajave" timelimit="60s" memlimit="4GB" cpuCores="1">

  <!-- ReachSafety (valid-assert) -->
  <rundefinition name="ReachSafety-Java">
    <tasks name="ReachSafety-Java">
      <includesfile>../sv-benchmarks/ReachSafety-Java.set</includesfile>
      <propertyfile>../sv-benchmarks/properties/valid-assert.prp</propertyfile>
    </tasks>
  </rundefinition>

  <!-- NoRuntimeException -->
  <rundefinition name="NoRuntimeException-Java">
    <tasks name="NoRuntimeException-Java">
      <includesfile>../sv-benchmarks/ReachSafety-Java.set</includesfile>
      <propertyfile>../sv-benchmarks/properties/no-runtime-exception.prp</propertyfile>
    </tasks>
  </rundefinition>

</benchmark>
